{
  "manifest_version": 3,
  "name": "Basketed Connect",
  "version": "1.3.0",
  "description": "Finishes a Basketed store connection in the browser you already use. Local-only: talks to 127.0.0.1 and nothing else.",
  "permissions": [
    "cookies",
    "webRequest",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://*.amazon.com/*",
    "https://*.bestbuy.com/*",
    "https://*.ebay.com/*",
    "https://*.etsy.com/*",
    "https://*.ikea.com/*",
    "https://*.target.com/*",
    "https://*.tesco.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
